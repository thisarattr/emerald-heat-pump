# Demo never connects to Emerald. Change to emerald when ready.
HEATER_DRIVER=demo
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_DATA_PATH=boost-data

# Live login requires HTTPS. Only disable for isolated HTTP development.
COOKIE_SECURE=true
# Only trust forwarding headers from your actual reverse proxy IP.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional for one heat pump; required when the account has multiple devices.
EMERALD_DEVICE_ID=
# Optional key source path when using compose.credentials.yaml (never put its contents here).
# CREDENTIAL_KEY_PATH=/absolute/path/outside-app-data/emerald.key
